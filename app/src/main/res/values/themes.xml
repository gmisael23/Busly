<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Busly" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/busly_primary</item>
        <item name="colorPrimaryVariant">@color/busly_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/busly_laranja</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/busly_fundo</item>
        <item name="android:statusBarColor">@color/busly_fundo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:textColorPrimary">@color/busly_primary</item>
    </style>

    <style name="Busly.Titulo" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/busly_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Busly.Secundario" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/busly_texto_secundario</item>
    </style>

    <style name="Busly.Label" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/busly_texto_secundario</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Busly.Campo" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/busly_primary</item>
        <item name="android:textColorHint">#8AA19D</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
