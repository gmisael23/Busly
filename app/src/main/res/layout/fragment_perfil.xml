<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Busly.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_perfil" />

        <!-- Responsável -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_branco"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvAvatarGrande"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_avatar"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@color/busly_primary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNomeResponsavel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/busly_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEmail"
                    style="@style/Busly.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Alunos -->
        <TextView
            style="@style/Busly.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/secao_alunos" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_branco"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvPerfilAluno1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/busly_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvPerfilAluno2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/busly_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Avisos -->
        <TextView
            style="@style/Busly.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/secao_avisos" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_branco"
            android:orientation="vertical"
            android:padding="14dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swProximidade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/aviso_proximidade"
                android:textColor="@color/busly_primary"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swChegada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/aviso_chegada"
                android:textColor="@color/busly_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSair"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_botao_contorno"
            android:text="@string/sair"
            android:textAllCaps="false"
            android:textColor="@color/busly_vermelho"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
